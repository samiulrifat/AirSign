# Copy to .env and fill in. Never commit .env.

# Session-cookie signing key. Generated into data/dev-secrets.json if empty.
AIRSIGN_SECRET_KEY=
# base64 of 32 random bytes; wraps the keys that encrypt signature templates.
# Generate: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
AIRSIGN_MASTER_KEY=

# "mock" uses the built-in PayPal stand-in; "sandbox" uses the PayPal sandbox.
AIRSIGN_PAYPAL_MODE=mock
AIRSIGN_PAYPAL_CLIENT_ID=
AIRSIGN_PAYPAL_CLIENT_SECRET=
# From the Developer Dashboard after adding a webhook for PAYMENT.CAPTURE.*
AIRSIGN_PAYPAL_WEBHOOK_ID=

# Labeled simulated gestures and locations for judges without a phone.
AIRSIGN_ALLOW_SIMULATION=true
# true when served over HTTPS
AIRSIGN_SECURE_COOKIES=false
AIRSIGN_TIMEZONE=America/New_York
# AIRSIGN_DATABASE_URL=sqlite:///data/airsign.db
